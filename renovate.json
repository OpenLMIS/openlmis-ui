{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/Warsaw",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": null,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "Group React core + types so majors move together",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "React"
    },
    {
      "description": "Group TanStack Query packages",
      "matchPackageNames": ["@tanstack/react-query", "@tanstack/react-query-devtools"],
      "groupName": "TanStack Query"
    },
    {
      "description": "Group TanStack Router packages",
      "matchPackageNames": [
        "@tanstack/react-router",
        "@tanstack/react-router-devtools",
        "@tanstack/router-plugin"
      ],
      "groupName": "TanStack Router"
    },
    {
      "description": "Group Biome packages",
      "matchPackageNames": ["@biomejs/biome"],
      "groupName": "Biome"
    },
    {
      "description": "Group Vite packages",
      "matchPackageNames": ["vite", "@vitejs/*"],
      "groupName": "Vite"
    },
    {
      "description": "Group Vitest packages",
      "matchPackageNames": ["vitest", "@vitest/*"],
      "groupName": "Vitest"
    },
    {
      "description": "Group Tailwind packages",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/vite", "tw-animate-css"],
      "groupName": "Tailwind"
    },
    {
      "description": "Group i18next packages",
      "matchPackageNames": ["i18next", "i18next-*", "react-i18next"],
      "groupName": "Internationalization"
    },
    {
      "description": "Group Testing Library packages",
      "matchPackageNames": ["@testing-library/*"],
      "groupName": "Testing Library"
    }
  ]
}
