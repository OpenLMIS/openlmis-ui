# Axios base URL. Keep it relative so the dev proxy (and any production rewrite)
# decides which OpenLMIS instance the app talks to.
VITE_API_BASE_URL=/api

# Where the dev server forwards `/api` requests.
VITE_API_PROXY_TARGET=https://uat.openlmis.org

# Dev server port.
VITE_FE_PORT=9000

# OAuth client the auth service authenticates before accepting the password grant.
VITE_AUTH_SERVER_CLIENT_ID=user-client
VITE_AUTH_SERVER_CLIENT_SECRET=changeme

VITE_SHOW_DEVTOOLS=true
