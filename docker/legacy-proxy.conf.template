server {
  listen 80;
  server_name _;

  # Docker's embedded DNS, with the host in a variable so nginx resolves it per
  # request instead of at config load. A static upstream makes the container
  # refuse to start whenever DNS is not ready yet.
  resolver 127.0.0.11 ipv6=off valid=30s;

  location / {
    set $upstream "${OL_UPSTREAM}";
    proxy_pass https://$upstream$request_uri;
    proxy_set_header Host ${OL_UPSTREAM};
    proxy_ssl_server_name on;
    proxy_ssl_name ${OL_UPSTREAM};

    # The upstream gateway 307s anything that does not look like HTTPS, which
    # would bounce the browser off localhost and break the shared origin.
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # Keep absolute redirects and cookies on this origin.
    proxy_redirect https://${OL_UPSTREAM}/ /;
    proxy_cookie_domain ${OL_UPSTREAM} localhost;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
  }
}
